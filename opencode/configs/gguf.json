{
  "$schema": "https://opencode.ai/config.json",
  "model": "ornith-gguf/local",
  "small_model": "ornith-gguf/local",
  "enabled_providers": [
    "ornith-gguf"
  ],
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "plugin": [],
  "mcp": {},
  "lsp": false,
  "formatter": false,
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 1536
  },
  "provider": {
    "ornith-gguf": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ornith-gguf",
      "options": {
        "baseURL": "http://127.0.0.1:8083/v1",
        "apiKey": "local-only"
      },
      "models": {
        "local": {
          "id": "gguf",
          "name": "gguf",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "default_agent": "ornith-code",
  "agent": {
    "ornith-code": {
      "description": "Local workspace coding agent",
      "mode": "primary",
      "model": "ornith-gguf/local",
      "temperature": 0.6,
      "top_p": 0.95,
      "steps": 12,
      "prompt": "You are a local programming agent. Work only in the current workspace. Read relevant files, make minimal changes, run the available tests, and report actual results. Never modify acceptance tests. Never use the network. Do not delegate.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "deny"
      }
    },
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    }
  }
}
